# Python virtual environment
.venv/
venv/
env/

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Environment variables (sensitive data)
.env

# IDE - PyCharm
.idea/


.claude/

# Flet / PyInstaller build output
build/
dist/
*.spec
*.exe

# Flutter cache
.flutter-plugins
.flutter-plugins-dependencies
.dart_tool/

# Config persistente con credenciales cifradas (generado en tiempo de ejecución)
config.json

# Outputs locales de los scripts de diagnóstico (scripts/diagnose_*.py, etc.)
scripts/*.out
scripts/*.txt
scripts/output/

# Carpetas locales de facturas/nóminas de prueba (las rutas reales se configuran
# por cliente desde la app y normalmente apuntan fuera del repo)
/facturas_test/
/nominas_test/
/Facturas/
/Backups/

# Logs de ejecución
*.log
